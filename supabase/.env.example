# Segredos da função `api` para desenvolvimento local.
# Copie para supabase/.env.local (já ignorado pelo git) e preencha.
# Em produção, use `supabase secrets set NOME=valor`. Nunca envie esses valores por chat ou e-mail.

# 32 bytes aleatórios em base64url. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET_KEY=

# Endereço do site (base dos links de acompanhamento e checagem de Origin).
SITE_URL=http://localhost:5173

# true na demonstração (habilita "Restaurar dados de demonstração"); false em cliente real.
IS_DEMO=true

# Mercado Pago (sandbox na demonstração).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Cloudflare Turnstile. Para testes, use as chaves de teste publicadas pela Cloudflare.
TURNSTILE_SECRET=

# Identificação exigida pelo Nominatim (OpenStreetMap): um e-mail de contato.
NOMINATIM_CONTACT=
GEOCODER_PROVIDER=nominatim

# SUPABASE_DB_URL, SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são fornecidos
# automaticamente pelo ambiente das funções do Supabase. Não defina à mão.
