# Variáveis públicas do site (Vite). Copie para .env.local e preencha.
# Nunca coloque segredos aqui: tudo que começa com VITE_ vai para o navegador.
VITE_TURNSTILE_SITE_KEY=

# Os segredos do servidor NÃO ficam neste arquivo.
# Local: supabase/.env.local (veja supabase/.env.example).
# Produção: `supabase secrets set NOME=valor` no projeto de cada cliente.
