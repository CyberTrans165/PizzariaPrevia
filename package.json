{
  "name": "forno-bella",
  "private": true,
  "version": "0.1.0",
  "description": "Forno Bella Pizzeria: site de pedidos delivery e painel do dono (demonstração).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:fn": "deno check supabase/functions/api/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/db/check.sh",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "bench:password": "tsx scripts/bench-password.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "fn:serve": "supabase functions serve api --env-file supabase/.env.local --no-verify-jwt",
    "build:vitrine": "vite build --mode vitrine",
    "dev:vitrine": "vite --mode vitrine"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "postgres": "^3.4.7",
    "prettier": "^3.5.0",
    "supabase": "^2.26.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
